{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npx --yes pnpm@10.4.1 install --frozen-lockfile",
  "buildCommand": "npx --yes pnpm@10.4.1 build",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/policy-brief",
      "destination": "/index.html"
    },
    {
      "source": "/methodology",
      "destination": "/index.html"
    }
  ]
}
